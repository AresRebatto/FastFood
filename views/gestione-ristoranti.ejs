<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestione Ristoranti - Area Ristoratore</title>

  <!-- Font Esterni -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@600&display=swap" rel="stylesheet">

  <!-- CSS Globali -->
  <link rel="stylesheet" href="/css/global.css">

  <!-- Alpine.js con defer -->
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/alpinejs/3.13.5/cdn.min.js"></script>

  <style>
    .gr-page {
      /* Palette ufficiale */
      --color-primary: #D8402A;
      --color-primary-dark: #A82F1E;
      --color-secondary: #1F3D2B;
      --color-accent: #F2A93B;
      --color-success: #3A7D44;
      --color-warning: #C97A0E;
      --color-error: #B3261E;
      --color-info: #2B6CB0;

      --color-neutral-900: #211C1A;
      --color-neutral-700: #4B4340;
      --color-neutral-400: #8C8380;
      --color-neutral-200: #E8E2DD;
      --color-neutral-100: #F5F1EC;
      --color-neutral-0: #FFFFFF;

      max-width: 980px;
      margin: 2rem auto;
      padding: 2rem;
      background: var(--color-neutral-0);
      border: 1px solid var(--color-neutral-200);
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(33, 28, 26, 0.06);
      color: var(--color-neutral-900);
      font-family: 'Inter', sans-serif;
    }

    .gr-head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 2rem;
      border-bottom: 2px solid var(--color-neutral-200);
      padding-bottom: 1.25rem;
      flex-wrap: wrap;
    }

    .gr-eyebrow {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--color-primary);
      margin: 0 0 0.35rem;
    }

    .gr-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 2.2rem;
      font-weight: 700;
      margin: 0;
      color: var(--color-neutral-900);
    }

    .gr-btn {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      border-radius: 6px;
      border: 1px solid transparent;
      padding: 0.65rem 1.25rem;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .gr-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .gr-btn--senape {
      background: var(--color-primary);
      color: var(--color-neutral-0);
      border-color: var(--color-primary);
    }
    .gr-btn--senape:hover:not(:disabled) {
      background: var(--color-primary-dark);
      border-color: var(--color-primary-dark);
    }

    .gr-btn--ghost {
      background: var(--color-neutral-100);
      border-color: var(--color-neutral-200);
      color: var(--color-neutral-900);
    }
    .gr-btn--ghost:hover {
      border-color: var(--color-secondary);
      color: var(--color-secondary);
    }

    .gr-btn--danger {
      background: transparent;
      border-color: var(--color-error);
      color: var(--color-error);
    }
    .gr-btn--danger:hover {
      background: var(--color-error);
      color: var(--color-neutral-0);
    }

    .gr-error {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.85rem;
      color: var(--color-error);
      background: #FDF2F2;
      border: 1px solid var(--color-error);
      padding: 0.75rem;
      border-radius: 6px;
      margin: 0 0 1.25rem;
    }

    .gr-loading, .gr-empty { color: var(--color-neutral-700); }
    .gr-empty {
      border: 2px dashed var(--color-neutral-200);
      border-radius: 8px;
      padding: 3rem 1.5rem;
      text-align: center;
      background: var(--color-neutral-100);
    }
    .gr-empty__hint { font-size: 0.95rem; color: var(--color-neutral-700); }

    .gr-list {
      display: grid;
      gap: 1.25rem;
    }

    .gr-card {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      background: var(--color-neutral-100);
      border: 1px solid var(--color-neutral-200);
      border-radius: 8px;
      padding: 1.4rem;
      flex-wrap: wrap;
    }

    .gr-card__name {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--color-neutral-900);
      margin: 0 0 0.35rem;
    }
    .gr-card__addr { margin: 0 0 0.35rem; color: var(--color-neutral-700); }
    .gr-card__meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.85rem;
      color: var(--color-neutral-700);
      margin: 0 0 0.5rem;
    }
    .gr-dot { margin: 0 0.4rem; color: var(--color-neutral-400); }
    .gr-card__dishes { font-size: 0.9rem; font-weight: 600; color: var(--color-secondary); margin: 0; }

    .gr-card__actions {
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
    }

    .gr-overlay {
      position: fixed;
      inset: 0;
      background: rgba(33, 28, 26, 0.6);
      backdrop-filter: blur(2px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 50;
      padding: 1rem;
    }

    .gr-confirm {
      background: var(--color-neutral-0);
      border: 1px solid var(--color-neutral-200);
      border-radius: 8px;
      padding: 1.75rem;
      max-width: 400px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    }
    .gr-confirm__actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.6rem;
      margin-top: 1.5rem;
    }

    .gr-panel {
      background: var(--color-neutral-0);
      border: 1px solid var(--color-neutral-200);
      border-radius: 10px;
      width: min(640px, 100%);
      max-height: 90vh;
      overflow-y: auto;
      padding: 2rem;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    }

    .gr-panel__head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid var(--color-neutral-200);
      padding-bottom: 0.75rem;
    }
    .gr-panel__head h2 { font-family: 'Space Grotesk', sans-serif; margin: 0; color: var(--color-neutral-900); }

    .gr-close {
      background: transparent;
      border: none;
      color: var(--color-neutral-400);
      font-size: 1.25rem;
      cursor: pointer;
    }
    .gr-close:hover { color: var(--color-neutral-900); }

    .gr-form { display: flex; flex-direction: column; gap: 1.2rem; }
    .gr-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

    .gr-field { display: flex; flex-direction: column; gap: 0.4rem; }
    .gr-field label {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--color-neutral-900);
    }
    .gr-field__hint {
      font-size: 0.85rem;
      color: var(--color-neutral-700);
      margin: -0.15rem 0 0.3rem;
    }

    .gr-field input, .gr-meal-search, .gr-meal-category {
      font-family: 'Inter', sans-serif;
      background: var(--color-neutral-100);
      border: 1px solid var(--color-neutral-200);
      border-radius: 6px;
      color: var(--color-neutral-900);
      padding: 0.65rem 0.8rem;
    }
    .gr-field input:focus, .gr-meal-search:focus, .gr-meal-category:focus {
      outline: none;
      border-color: var(--color-primary);
      box-shadow: 0 0 0 2px rgba(216, 64, 42, 0.15);
    }

    .gr-selected {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-bottom: 0.6rem;
    }
    .gr-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(242, 169, 59, 0.15);
      border: 1px solid var(--color-accent);
      color: var(--color-neutral-900);
      border-radius: 999px;
      padding: 0.25rem 0.5rem 0.25rem 0.75rem;
      font-size: 0.85rem;
      font-weight: 500;
    }
    .gr-chip button {
      background: transparent;
      border: none;
      color: var(--color-neutral-700);
      cursor: pointer;
      font-size: 0.8rem;
    }
    .gr-chip button:hover { color: var(--color-error); }

    .gr-meal-filters {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 0.6rem;
      margin-bottom: 0.6rem;
    }

    .gr-meal-list {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      max-height: 320px;
      overflow-y: auto;
      border: 1px solid var(--color-neutral-200);
      background: var(--color-neutral-100);
      border-radius: 8px;
      padding: 0.5rem;
    }

    .gr-meal {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.5rem;
      border-radius: 6px;
      cursor: pointer;
    }
    .gr-meal:hover { background: var(--color-neutral-0); }
    .gr-meal--on { background: rgba(31, 61, 43, 0.08); }

    .gr-meal__check { accent-color: var(--color-secondary); }
    .gr-meal__thumb {
      width: 42px;
      height: 42px;
      object-fit: cover;
      border-radius: 6px;
      flex-shrink: 0;
    }
    .gr-meal__info { display: flex; flex-direction: column; }
    .gr-meal__name { font-size: 0.9rem; font-weight: 500; color: var(--color-neutral-900); }
    .gr-meal__tags {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      color: var(--color-neutral-700);
    }
    .gr-meal-empty { text-align: center; color: var(--color-neutral-700); font-size: 0.85rem; padding: 1rem 0; }

    .gr-panel__actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.6rem;
      margin-top: 0.75rem;
    }

    @media (max-width: 600px) {
      .gr-page { margin: 0; border-radius: 0; border: none; padding: 1.25rem; }
      .gr-row, .gr-meal-filters { grid-template-columns: 1fr; }
      .gr-panel { max-height: 100vh; height: 100%; border-radius: 0; }
    }
  </style>
</head>
<body>

  <%- include('./components/header', { role }) %>

  <main class="gr-page" x-data="gestioneRistoranti()">

    <header class="gr-head">
      <div>
        <p class="gr-eyebrow">Area ristoratore</p>
        <h1 class="gr-title">I tuoi ristoranti</h1>
      </div>
      <button type="button" class="gr-btn gr-btn--senape" @click="openCreate()">
        + Nuovo ristorante
      </button>
    </header>

    <p class="gr-error" x-show="error" x-transition x-text="error"></p>

    <!-- LISTA RISTORANTI -->
    <section class="gr-list">
      <template x-if="ristoranti.length === 0">
        <div class="gr-empty">
          <p>Non hai ancora nessun ristorante.</p>
          <p class="gr-empty__hint">Crea il primo per iniziare a comporre il menù.</p>
        </div>
      </template>

      <template x-for="r in ristoranti" :key="r._id">
        <article class="gr-card">
          <div class="gr-card__main">
            <h2 class="gr-card__name" x-text="r.nome"></h2>
            <p class="gr-card__addr" x-text="r.via"></p>
            <p class="gr-card__meta">
              <span x-text="'Tel. ' + r.n_tell"></span>
              <span class="gr-dot">·</span>
              <span x-text="'P.IVA ' + r.piva"></span>
            </p>
            <p class="gr-card__dishes" x-text="(r.menu?.length || 0) + ' piatti nel menù'"></p>
          </div>
          <div class="gr-card__actions">
            <button type="button" class="gr-btn gr-btn--ghost" @click="openEdit(r)">Modifica</button>
            <button type="button" class="gr-btn gr-btn--danger" @click="askDelete(r._id)">Elimina</button>
          </div>
        </article>
      </template>
    </section>

    <!-- CONFERMA ELIMINAZIONE -->
    <div class="gr-overlay" x-show="confirmingDeleteId" x-transition.opacity @click.self="cancelDelete()">
      <div class="gr-confirm">
        <p>Eliminare definitivamente questo ristorante? L'operazione non è reversibile.</p>
        <div class="gr-confirm__actions">
          <button type="button" class="gr-btn gr-btn--ghost" @click="cancelDelete()">Annulla</button>
          <button type="button" class="gr-btn gr-btn--danger" @click="confirmDelete()">Elimina</button>
        </div>
      </div>
    </div>

    <!-- PANNELLO CREA/MODIFICA -->
    <div class="gr-overlay" x-show="panelOpen" x-transition.opacity @keydown.escape.window="closePanel()">
      <div class="gr-panel" @click.outside="closePanel()">

        <div class="gr-panel__head">
          <h2 x-text="editingId ? 'Modifica ristorante' : 'Nuovo ristorante'"></h2>
          <button type="button" class="gr-close" @click="closePanel()" aria-label="Chiudi">✕</button>
        </div>

        <form class="gr-form" @submit.prevent="saveRistorante()">

          <div class="gr-field">
            <label for="nome">Nome</label>
            <input id="nome" type="text" x-model="form.nome" required maxlength="120" placeholder="Es. Osteria del Senape">
          </div>

          <div class="gr-field">
            <label for="via">Via</label>
            <input id="via" type="text" x-model="form.via" required maxlength="160" placeholder="Es. Via Roma 12">
          </div>

          <div class="gr-row">
            <div class="gr-field">
              <label for="n_tell">Telefono</label>
              <input id="n_tell" type="tel" x-model="form.n_tell" required pattern="[0-9+ ]{6,20}" placeholder="Es. 0381 123456">
            </div>
            <div class="gr-field">
              <label for="piva">Partita IVA</label>
              <input id="piva" type="text" x-model="form.piva" required maxlength="11" minlength="11" placeholder="11 cifre">
            </div>
          </div>

          <!-- SELETTORE MENU -->
          <div class="gr-field">
            <label>Menù</label>
            <p class="gr-field__hint">Cerca e seleziona i piatti da inserire nel menù del ristorante.</p>

            <div class="gr-selected" x-show="form.menu.length > 0">
              <template x-for="m in form.menu" :key="m.idMeal">
                <span class="gr-chip">
                  <span x-text="m.strMeal"></span>
                  <button type="button" @click="removeMeal(m.idMeal)" aria-label="Rimuovi piatto">✕</button>
                </span>
              </template>
            </div>

            <div class="gr-meal-filters">
              <input
                type="search"
                x-model="mealQuery"
                placeholder="Cerca piatto per nome…"
                class="gr-meal-search">
              <select x-model="mealCategoryFilter" class="gr-meal-category">
                <option value="">Tutte le categorie</option>
                <template x-for="c in categories" :key="c">
                  <option :value="c" x-text="c"></option>
                </template>
              </select>
            </div>

            <div class="gr-meal-list">
              <template x-for="meal in filteredMeals" :key="meal.idMeal">
                <label class="gr-meal" :class="{ 'gr-meal--on': selectedIds.includes(meal.idMeal) }">
                  <input
                    type="checkbox"
                    class="gr-meal__check"
                    :checked="selectedIds.includes(meal.idMeal)"
                    @change="toggleMeal(meal)">
                  <img class="gr-meal__thumb" :src="meal.strMealThumb" :alt="meal.strMeal" loading="lazy">
                  <span class="gr-meal__info">
                    <span class="gr-meal__name" x-text="meal.strMeal"></span>
                    <span class="gr-meal__tags" x-text="meal.strCategory + ' · ' + meal.strArea"></span>
                  </span>
                </label>
              </template>

              <p class="gr-meal-empty" x-show="filteredMeals.length === 0">Nessun piatto trovato.</p>
            </div>
          </div>

          <p class="gr-error" x-show="formError" x-text="formError"></p>

          <div class="gr-panel__actions">
            <button type="button" class="gr-btn gr-btn--ghost" @click="closePanel()">Annulla</button>
            <button type="submit" class="gr-btn gr-btn--senape" :disabled="saving">
              <span x-text="saving ? 'Salvataggio…' : (editingId ? 'Salva modifiche' : 'Crea ristorante')"></span>
            </button>
          </div>

        </form>
      </div>
    </div>

  </main>

  <!-- Passaggio sicuro dei dati EJS tramite tag script JSON -->
  <script id="ejs-meals-data" type="application/json"><%- JSON.stringify(meals || []) %></script>
  <script id="ejs-ristoranti-data" type="application/json"><%- JSON.stringify(ristoranti || []) %></script>

  <script>
    let initialMeals = [];
    let initialRistoranti = [];

    try {
      initialMeals = JSON.parse(document.getElementById('ejs-meals-data').textContent);
      initialRistoranti = JSON.parse(document.getElementById('ejs-ristoranti-data').textContent);
    } catch (err) {
      console.error('Errore nel parsing dei dati EJS:', err);
    }

    function gestioneRistoranti() {
      return {
        ALL_MEALS: initialMeals,
        ristoranti: initialRistoranti,
        error: '',

        panelOpen: false,
        editingId: null,
        saving: false,
        formError: '',
        form: { nome: '', via: '', n_tell: '', piva: '', menu: [] },

        mealQuery: '',
        mealCategoryFilter: '',

        confirmingDeleteId: null,

        get categories() {
          return [...new Set(this.ALL_MEALS.map(m => m.strCategory))].sort();
        },

        get selectedIds() {
          return this.form.menu.map(m => m.idMeal);
        },

        get filteredMeals() {
          const q = this.mealQuery.trim().toLowerCase();
          return this.ALL_MEALS.filter(m => {
            const matchesQuery = !q || m.strMeal.toLowerCase().includes(q);
            const matchesCategory = !this.mealCategoryFilter || m.strCategory === this.mealCategoryFilter;
            return matchesQuery && matchesCategory;
          }).slice(0, 60);
        },

        openCreate() {
          this.editingId = null;
          this.form = { nome: '', via: '', n_tell: '', piva: '', menu: [] };
          this.mealQuery = '';
          this.mealCategoryFilter = '';
          this.formError = '';
          this.panelOpen = true;
        },

        openEdit(r) {
          this.editingId = r._id;
          this.form = {
            nome: r.nome,
            via: r.via,
            n_tell: r.n_tell,
            piva: r.piva,
            menu: [...(r.menu || [])]
          };
          this.mealQuery = '';
          this.mealCategoryFilter = '';
          this.formError = '';
          this.panelOpen = true;
        },

        closePanel() {
          if (this.saving) return;
          this.panelOpen = false;
        },

        toggleMeal(meal) {
          const idx = this.form.menu.findIndex(m => m.idMeal === meal.idMeal);
          if (idx === -1) {
            this.form.menu.push(meal);
          } else {
            this.form.menu.splice(idx, 1);
          }
        },

        removeMeal(idMeal) {
          this.form.menu = this.form.menu.filter(m => m.idMeal !== idMeal);
        },

        async saveRistorante() {
          this.formError = '';

          if (this.form.piva.length !== 11) {
            this.formError = 'La partita IVA deve avere 11 cifre.';
            return;
          }

          this.saving = true;
          const isEdit = !!this.editingId;
          const url = isEdit ? `/api/ristoranti/${this.editingId}` : '/api/ristoranti';
          const method = isEdit ? 'PUT' : 'POST';

          try {
            const res = await fetch(url, {
              method,
              credentials: 'include',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(this.form)
            });

            if (!res.ok) {
              const data = await res.json().catch(() => ({}));
              throw new Error(data.message || 'Salvataggio non riuscito.');
            }

            const saved = await res.json();

            if (isEdit) {
              this.ristoranti = this.ristoranti.map(r => r._id === saved._id ? saved : r);
            } else {
              this.ristoranti.push(saved);
            }

            this.panelOpen = false;
          } catch (err) {
            this.formError = err.message || 'Errore di rete.';
          } finally {
            this.saving = false;
          }
        },

        askDelete(id) {
          this.confirmingDeleteId = id;
        },

        cancelDelete() {
          this.confirmingDeleteId = null;
        },

        async confirmDelete() {
          const id = this.confirmingDeleteId;
          if (!id) return;

          try {
            const res = await fetch(`/api/ristoranti/${id}`, {
              method: 'DELETE',
              credentials: 'include'
            });
            if (!res.ok) throw new Error('Eliminazione non riuscita.');

            this.ristoranti = this.ristoranti.filter(r => r._id !== id);
          } catch (err) {
            this.error = err.message || 'Errore di rete.';
          } finally {
            this.confirmingDeleteId = null;
          }
        }
      };
    }
  </script>
</body>
</html>
