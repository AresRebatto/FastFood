<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Statistiche Ristoranti</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/statistiche.css">

  <!-- Alpine.js CDN -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>


</head>
<body>

  <%- include('components/header', { role }) %>

  <main class="container statistiche-page">

    <h1 class="page-title">Statistiche ristoranti</h1>

    <div x-data="statisticheApp()" x-init="init()">

      <!-- Stato Vuoto -->
      <template x-if="statistiche.length === 0">
        <p class="empty-state">Non ci sono ancora statistiche disponibili.</p>
      </template>

      <!-- Controlli di Ordinamento -->
      <template x-if="statistiche.length > 0">
        <div class="stats-toolbar">
          <label for="sortSelect">Ordina per</label>
          <select id="sortSelect" x-model="sortBy" @change="applySort()">
            <option value="nome">Nome ristorante</option>
            <option value="ricavo">Ricavo medio</option>
          </select>
        </div>
      </template>

      <!-- Griglia Schede Ristorante -->
      <div class="stats-grid">
        <template x-for="ristorante in statistiche" :key="ristorante.nomeRistorante">
          <div class="stat-card" x-data="restaurantChart(ristorante.incassoUltimaSettimana)">

            <div class="stat-card-header">
              <h2 class="stat-restaurant-name" x-text="ristorante.nomeRistorante"></h2>
              <span class="stat-top-dish" x-text="'🍽️ ' + ristorante.piattoTop.strMeal"></span>
            </div>

            <div class="stat-revenue">
              <span class="stat-revenue-label">Ricavo medio</span>
              <span class="stat-revenue-value" x-text="formatCurrency(ristorante.ricavoMedio)"></span>
            </div>

            <div class="stat-chart">
              <div class="stat-chart-bars">
                <template x-for="day in days" :key="day.key">
                  <div
                    class="stat-bar-wrapper"
                    @mouseenter="hovered = day.key"
                    @mouseleave="hovered = null"
                  >
                    <div class="stat-bar-tooltip"
                         x-show="hovered === day.key"
                         x-cloak
                         x-text="formatCurrency(values[day.key])">
                    </div>
                    <div class="stat-bar-track">
                      <div
                        class="stat-bar-fill"
                        :style="{ height: barHeight(day.key) + '%' }"
                        :class="{ 'stat-bar-fill--active': hovered === day.key }"
                      ></div>
                    </div>
                    <span class="stat-bar-label" x-text="day.label"></span>
                  </div>
                </template>
              </div>
            </div>

          </div>
        </template>
      </div>

    </div>

  </main>

  <%- include('components/footer') %>

  <!-- Dati Server-Side Iniettati via EJS -->
  <script type="application/json" id="statistiche-data">
    <%- JSON.stringify(statistiche || []) %>
  </script>

   <script src="/js/statistiche.js"></script>

  


</body>
</html>
