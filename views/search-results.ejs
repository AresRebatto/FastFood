<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Risultati della ricerca</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/search-result.css">
  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body>

  <%- include('components/header') %>

  <section class="search-bar-sticky">
    <form
      id="searchForm"
      action="#"
      onsubmit="handleSearch(event)"
      class="search-bar-compact"
    >
      <select name="tipo" id="searchKind" class="search-select" onchange="updatePlaceholder(this.value)">
        <option value="restaurants" <%= searchKind === 'restaurants' ? 'selected' : '' %>>Ristoranti</option>
        <option value="dishes" <%= searchKind === 'dishes' ? 'selected' : '' %>>Piatti</option>
      </select>

      <input
        type="text"
        id="searchInput"
        name="q"
        value="<%= query || '' %>"
        placeholder="<%= searchKind === 'dishes' ? 'Cerca un piatto...' : 'Cerca un ristorante...' %>"
        class="search-input"
      />

      <button type="submit" class="search-btn">Cerca</button>
    </form>
  </section>

  <main class="results-page">

    <div class="results-header">
      <h2><%= results.length %> risultat<%= results.length === 1 ? 'o' : 'i' %> per "<%= query %>"</h2>
    </div>

    <% if (!results || results.length === 0) { %>
      <div class="no-results">
        <p>Nessun risultato trovato. Prova con un'altra ricerca.</p>
      </div>
    <% } else { %>
      <div class="results-grid">

        <% results.forEach(function(item) { %>

          <% if (searchKind === 'restaurants') { %>

            <!-- ===== CARD RISTORANTE ===== -->
            <div class="card card-ristorante">
              <div class="card-body">
                <h3 class="card-title"><%= item.nome %></h3>
                <p class="card-via"><%= item.via %></p>
              </div>
              <a href="/ristorante/<%= item.id %>" class="btn-espandi">
                Espandi
              </a>
            </div>

          <% } else if (searchKind === 'dishes') { %>

            <!-- ===== CARD PIATTO ===== -->
            <div
              class="card card-piatto"
              x-data="{
                qty: 1,
                added: false,
                item: <%- JSON.stringify({
                  id: item.id,
                  nome: item.nome,
                  idMeal: item.idMeal,
                  strMeal: item.strMeal,
                  strMealThumb: item.strMealThumb,
                  price: item.price
                }).replace(/"/g, '&quot;') %>
              }"
            >
              <img
                src="<%= item.strMealThumb %>"
                alt="<%= item.strMeal %>"
                class="card-img"
              />
              <div class="card-body">
                <span class="badge-categoria"><%= item.strCategory %></span>
                <h3 class="card-title"><%= item.strMeal %></h3>

                <div class="card-ristorante-info">
                  <p class="card-nome-ristorante"><%= item.nome %></p>
                  <p class="card-via"><%= item.via %></p>
                  <% if (item.price !== undefined && item.price !== null) { %>
                    <p class="card-prezzo">€<%= Number(item.price).toFixed(2) %></p>
                  <% } %>
                </div>

                <div class="card-actions">
                  <div class="qty-selector">
                    <button
                      type="button"
                      @click.stop="qty > 1 && qty--"
                      class="qty-btn"
                    >−</button>
                    <span class="qty-value" x-text="qty"></span>
                    <button
                      type="button"
                      @click.stop="qty++"
                      class="qty-btn"
                    >+</button>
                  </div>

                  <button
                    type="button"
                    class="btn-ordina"
                    :class="{ 'btn-ordina--added': added }"
                    @click.stop="
                      $store.cart.addItem(item, qty, () => {
                        added = true;
                        setTimeout(() => added = false, 1200);
                      });
                    "
                  >
                    <span x-show="!added">Ordina</span>
                    <span x-show="added" x-cloak>Aggiunto ✓</span>
                  </button>
                </div>
              </div>

              <a href="/ristorante/<%= item.id %>" class="btn-espandi btn-espandi--ghost">
                Vedi locale
              </a>
            </div>

          <% } %>

        <% }) %>

      </div>
    <% } %>

  </main>

  <!-- ===== COMPONENTE CARRELLO ===== -->
  <%- include('components/cart') %>

  <script>
    function handleSearch(event) {
      event.preventDefault();

      const kind = document.getElementById('searchKind').value;
      const query = document.getElementById('searchInput').value.trim();

      if (!query) return;

      const params = new URLSearchParams({ q: query });
      window.location.href = `/search-result/${kind}?${params.toString()}`;
    }

    function updatePlaceholder(kind) {
      const input = document.getElementById('searchInput');
      input.placeholder = kind === 'dishes' ? 'Cerca un piatto...' : 'Cerca un ristorante...';
    }
  </script>
</body>
</html>
