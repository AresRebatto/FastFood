<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ordini in Arrivo</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />

  <!-- Global CSS -->
  <link rel="stylesheet" href="/css/global.css">

  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <style>
    :root {
      --color-primary: #D8402A;
      --color-primary-dark: #A82F1E;
      --color-secondary: #1F3D2B;
      --color-success: #3A7D44;
      --color-error: #B3261E;
      --color-neutral-900: #211C1A;
      --color-neutral-700: #4B4340;
      --color-neutral-400: #8C8380;
      --color-neutral-200: #E8E2DD;
      --color-neutral-100: #F5F1EC;
      --color-neutral-0: #FFFFFF;
      --color-warning: #D97706;
      --color-info: #2563EB;

      --font-heading: 'Space Grotesk', sans-serif;
      --font-body: 'Inter', sans-serif;
      --font-mono: 'IBM Plex Mono', monospace;

      --radius-sm: 6px;
      --radius-md: 10px;
      --radius-lg: 14px;
      --radius-full: 9999px;
    }

    [x-cloak] { display: none !important; }

    body {
      background-color: var(--color-neutral-100);
      color: var(--color-neutral-900);
      font-family: var(--font-body);
      margin: 0;
      padding: 0;
    }

    .ordini-page {
      padding-block: 2rem 4rem;
      max-width: 800px;
      margin-inline: auto;
      padding-inline: 1rem;
    }

    .ordini-page__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .ordini-page__title {
      font-family: var(--font-heading);
      font-size: 1.75rem;
      color: var(--color-neutral-900);
      margin: 0;
    }

    /* Pulsante outline Alpine integrato */
    .btn-outline {
      background: transparent;
      border: 1px solid var(--color-neutral-400);
      color: var(--color-neutral-700);
      padding: 0.5rem 1rem;
      border-radius: var(--radius-sm);
      font-family: var(--font-body);
      font-weight: 500;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-outline:hover {
      background-color: var(--color-neutral-200);
      color: var(--color-neutral-900);
    }

    .ordini-empty {
      font-family: var(--font-body);
      color: var(--color-neutral-700);
      background-color: var(--color-neutral-0);
      border: 1px dashed var(--color-neutral-200);
      border-radius: var(--radius-lg);
      padding: 3rem 1.5rem;
      text-align: center;
    }

    .ordini-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .ordine-card {
      background: var(--color-neutral-0);
      border: 1px solid var(--color-neutral-200);
      border-radius: var(--radius-lg);
      padding: 1.25rem 1.5rem;
      color: var(--color-neutral-900);
      box-shadow: 0 2px 4px rgba(33, 28, 26, 0.04);
      transition: opacity 0.2s ease, box-shadow 0.2s ease;
    }

    .ordine-card:hover {
      box-shadow: 0 4px 12px rgba(33, 28, 26, 0.08);
    }

    .ordine-card--done {
      opacity: 0.65;
      background-color: #FAF8F5;
    }

    .ordine-card__top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
    }

    .ordine-card__ristorante {
      font-family: var(--font-heading);
      font-size: 1.15rem;
      color: var(--color-neutral-900);
      margin: 0 0 0.25rem;
    }

    .ordine-card__via {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      margin: 0;
      color: var(--color-neutral-700);
      font-size: 0.875rem;
    }

    .ordine-card__pin {
      flex-shrink: 0;
      color: var(--color-neutral-400);
    }

    /* Badge degli Stati */
    .stato-badge {
      flex-shrink: 0;
      padding: 0.3rem 0.75rem;
      border-radius: var(--radius-full);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      white-space: nowrap;
    }

    /* O: Ordinato */
    .stato-badge--O {
      background: var(--color-neutral-200);
      color: var(--color-neutral-700);
    }

    /* P: In preparazione */
    .stato-badge--P {
      background: #FEF3C7;
      color: #92400E;
    }

    /* >: In consegna */
    .stato-badge--\> {
      background: #E0E7FF;
      color: #3730A3;
    }

    /* C: Consegnato */
    .stato-badge--C {
      background: #DCFCE7;
      color: var(--color-success);
    }

    /* Stepper */
    .ordine-stepper {
      margin: 1.25rem 0;
    }

    .ordine-stepper__track {
      height: 6px;
      background: var(--color-neutral-200);
      border-radius: var(--radius-full);
      overflow: hidden;
    }

    .ordine-stepper__fill {
      height: 100%;
      background: var(--color-primary);
      transition: width 0.4s ease;
    }

    .ordine-stepper__labels {
      display: flex;
      justify-content: space-between;
      margin-top: 0.5rem;
      font-size: 0.75rem;
      color: var(--color-neutral-400);
      font-weight: 500;
    }

    .ordine-stepper__labels .is-active {
      color: var(--color-primary-dark);
      font-weight: 600;
    }

    /* Lista Piatti */
    .ordine-piatti {
      list-style: none;
      margin: 0 0 1.25rem;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      font-size: 0.9rem;
    }

    .ordine-piatti li {
      display: flex;
      gap: 0.5rem;
      color: var(--color-neutral-900);
    }

    .ordine-piatti__qty {
      font-family: var(--font-mono);
      font-weight: 600;
      color: var(--color-primary);
    }

    /* Card Footer */
    .ordine-card__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.75rem;
      padding-top: 0.85rem;
      border-top: 1px solid var(--color-neutral-200);
    }

    .ordine-card__meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      font-family: var(--font-mono);
      font-size: 0.875rem;
    }

    .ordine-timer {
      color: var(--color-neutral-700);
    }

    .ordine-timer--ready {
      color: var(--color-success);
      font-weight: 600;
    }

    .ordine-costo {
      font-weight: 600;
      font-size: 1rem;
      color: var(--color-neutral-900);
    }
  </style>
</head>
<body>

  <%- include('components/header', { role }) %>

  <main class="container ordini-page" x-data="ordiniRistorante()" x-init="init()" x-cloak>

    <div class="ordini-page__head">
      <h1 class="ordini-page__title">Ordini in arrivo</h1>
      <button
        type="button"
        class="btn btn-outline btn-sm"
        @click="showHistory = !showHistory"
      >
        <span x-text="showHistory ? 'Nascondi ordini precedenti' : 'Vedi anche ordini precedenti'"></span>
      </button>
    </div>

    <template x-if="ordiniFiltrati.length === 0">
      <p class="ordini-empty">Nessun ordine in corso al momento.</p>
    </template>

    <div class="ordini-list">
      <template x-for="ordine in ordiniFiltrati" :key="ordine._id">
        <article class="ordine-card" :class="{ 'ordine-card--done': ordine.stato === 'C' }">

          <div class="ordine-card__top">
            <div>
              <h2 class="ordine-card__ristorante" x-text="ordine.nome_ristorante"></h2>
              <p class="ordine-card__via">
                <svg class="ordine-card__pin" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 21s-7-6.5-7-11.5a7 7 0 1 1 14 0C19 14.5 12 21 12 21z"/>
                  <circle cx="12" cy="9.5" r="2.3"/>
                </svg>
                <span x-text="ordine.via_ristorante"></span>
              </p>
            </div>
            <span class="stato-badge" :class="'stato-badge--' + ordine.stato" x-text="statusLabel(ordine.stato)"></span>
          </div>

          <div class="ordine-stepper" role="progressbar" :aria-valuenow="statusStep(ordine.stato)" aria-valuemin="0" aria-valuemax="3">
            <div class="ordine-stepper__track">
              <div class="ordine-stepper__fill" :style="`width: ${(statusStep(ordine.stato) / 3) * 100}%`"></div>
            </div>
            <div class="ordine-stepper__labels">
              <span :class="{ 'is-active': statusStep(ordine.stato) >= 0 }">Ordinato</span>
              <span :class="{ 'is-active': statusStep(ordine.stato) >= 1 }">In preparazione</span>
              <span :class="{ 'is-active': statusStep(ordine.stato) >= 2 }">In consegna</span>
              <span :class="{ 'is-active': statusStep(ordine.stato) >= 3 }">Consegnato</span>
            </div>
          </div>

          <ul class="ordine-piatti">
            <template x-for="piatto in ordine.piatti" :key="piatto.strMeal">
              <li>
                <span class="ordine-piatti__qty" x-text="'x' + piatto.qty"></span>
                <span x-text="piatto.strMeal"></span>
              </li>
            </template>
          </ul>

          <div class="ordine-card__footer">
            <div class="ordine-card__meta">
              <span class="ordine-timer" :class="{ 'ordine-timer--ready': ordine.stato === 'C' }">
                <!-- Se lo stato è C -->
                <template x-if="ordine.stato === 'C'">
                  <span>Pronto per il ritiro</span>
                </template>

                <!-- Se lo stato NON è C -->
                <template x-if="ordine.stato !== 'C'">
                  <span>
                    <template x-if="ordine.tempo_rimanente > 0">
                      <span x-text="ordine.tempo_rimanente + ' min rimanenti'"></span>
                    </template>
                    <template x-if="ordine.tempo_rimanente <= 0">
                      <span>In arrivo a momenti</span>
                    </template>
                  </span>
                </template>
              </span>
              <span class="ordine-costo" x-text="'€ ' + Number(ordine.costo).toFixed(2)"></span>
            </div>
          </div>

        </article>
      </template>
    </div>

  </main>

  <script>
  function ordiniRistorante() {
    return {
      ordini: [],
      showHistory: false,

      init() {
        this.ordini = JSON.parse(document.getElementById('ordini-data').textContent);

        setInterval(() => {
          this.ordini.forEach(o => {
            if (o.stato !== 'C' && o.tempo_rimanente > 0) o.tempo_rimanente--;
          });
        }, 60000);
      },

      get ordiniFiltrati() {
        return this.showHistory
          ? this.ordini
          : this.ordini.filter(o => o.stato !== 'C');
      },

      statusLabel(stato) {
        return { O: 'Ordinato', P: 'In preparazione', '>': 'In consegna', C: 'Consegnato' }[stato] ?? stato;
      },

      statusStep(stato) {
        return { O: 0, P: 1, '>': 2, C: 3 }[stato] ?? 0;
      }
    };
  }
  </script>

  <script type="application/json" id="ordini-data">
    <%- JSON.stringify(ordini) %>
  </script>
</body>
</html>
