<!DOCTYPE html>
<html lang="it">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Il tuo profilo</title>

	<!-- Google Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />

	<!-- CSS -->
	<link rel="stylesheet" href="/css/global.css" />
	<link rel="stylesheet" href="/css/profile.css" />

	<!-- Alpine.js -->
	<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body>

	<%- include('components/header', {role}) %>

	<main class="container profile-page" x-data="profiloPage()" x-init="init()">

		<script id="dati-profilo-iniziali" type="application/json">
			{
				"nome": <%- JSON.stringify(nome) %>,
				"cognome": <%- JSON.stringify(cognome) %>,
				"metodiPagamento": <%- JSON.stringify(metodi_pagamento || []) %>
			}
		</script>

		<div class="profile-intro">
			<h1 class="profile-title">Il tuo profilo</h1>
			<p class="profile-subtitle">Gestisci i tuoi dati personali, la password e i metodi di pagamento.</p>
		</div>

		<!-- Messaggi di stato invio -->
		<div class="alert alert-success" x-show="messaggioSuccesso" x-cloak x-transition role="status">
			<span x-text="messaggioSuccesso"></span>
		</div>
		<div class="alert alert-error" x-show="messaggioErrore" x-cloak x-transition role="alert">
			<span x-text="messaggioErrore"></span>
		</div>

		<!-- ===================== DATI PERSONALI ===================== -->
		<section class="profile-card">
			<h2 class="profile-card-title">Dati personali</h2>
			<div class="field-grid">
				<div class="field-group">
					<label for="campo-nome">Nome</label>
					<input
						type="text"
						id="campo-nome"
						name="nome"
						x-model="nome"
						autocomplete="given-name">
				</div>
				<div class="field-group">
					<label for="campo-cognome">Cognome</label>
					<input
						type="text"
						id="campo-cognome"
						name="cognome"
						x-model="cognome"
						autocomplete="family-name">
				</div>
			</div>
		</section>

		<!-- ===================== PASSWORD ===================== -->
		<section class="profile-card">
			<div class="profile-card-header">
				<h2 class="profile-card-title">Password</h2>
				<button
					type="button"
					class="btn btn-outline btn-sm"
					@click="mostraCampiPassword = !mostraCampiPassword">
					<span x-text="mostraCampiPassword ? 'Annulla' : 'Cambia password'"></span>
				</button>
			</div>

			<div class="field-grid" x-show="mostraCampiPassword" x-cloak x-transition>
				<div class="field-group">
					<label for="campo-nuova-password">Nuova password</label>
					<div class="input-with-action">
						<input
							:type="passwordVisibile ? 'text' : 'password'"
							id="campo-nuova-password"
							name="nuova_password"
							x-model="nuovaPassword"
							autocomplete="new-password"
							:aria-invalid="nuovaPassword.length > 0 && nuovaPassword.length < 8">
						<button
							type="button"
							class="icon-btn icon-btn-sm"
							@click="passwordVisibile = !passwordVisibile"
							:aria-label="passwordVisibile ? 'Nascondi password' : 'Mostra password'">
							<span x-text="passwordVisibile ? '🙈' : '👁️'" aria-hidden="true"></span>
						</button>
					</div>
					<p class="field-hint" x-show="nuovaPassword.length > 0 && nuovaPassword.length < 8" x-cloak>
						La password deve contenere almeno 8 caratteri.
					</p>
				</div>
				<div class="field-group">
					<label for="campo-conferma-password">Conferma nuova password</label>
					<input
						:type="passwordVisibile ? 'text' : 'password'"
						id="campo-conferma-password"
						name="conferma_password"
						x-model="confermaPassword"
						autocomplete="new-password"
						:aria-invalid="confermaPassword.length > 0 && confermaPassword !== nuovaPassword">
					<p class="field-hint field-hint-error" x-show="confermaPassword.length > 0 && confermaPassword !== nuovaPassword" x-cloak>
						Le due password non coincidono.
					</p>
				</div>
			</div>
		</section>

		<!-- ===================== METODI DI PAGAMENTO ===================== -->
		<section class="profile-card">
			<div class="profile-card-header">
				<h2 class="profile-card-title">Metodi di pagamento</h2>
				<button type="button" class="btn btn-outline btn-sm" @click="aggiungiCarta()">
					+ Aggiungi carta
				</button>
			</div>

			<!-- Stato vuoto -->
			<div class="empty-state" x-show="carte.length === 0" x-cloak>
				<span class="empty-state-icon" aria-hidden="true">💳</span>
				<p>Non hai ancora nessun metodo di pagamento salvato.</p>
				<button type="button" class="btn btn-primary btn-sm" @click="aggiungiCarta()">
					Aggiungi la tua prima carta
				</button>
			</div>

			<!-- Lista carte -->
			<template x-for="carta in carte" :key="carta._chiave">
				<div class="card-item">
					<div class="card-item-header">
						<span
							class="badge-circuito"
							:class="{ 'badge-circuito-errore': circuito(carta.numero_carta) === 'sconosciuto' }"
							x-text="etichettaCircuito(carta.numero_carta) || 'Nuova carta'">
						</span>
						<button
							type="button"
							class="icon-btn icon-btn-sm"
							@click="rimuoviCarta(carta._chiave)"
							aria-label="Rimuovi carta">
							<span aria-hidden="true">🗑️</span>
						</button>
					</div>

					<div class="field-grid field-grid-carta">
						<div class="field-group field-group-numero">
							<label :for="'numero-' + carta._chiave">Numero carta</label>
							<input
								type="text"
								inputmode="numeric"
								:id="'numero-' + carta._chiave"
								x-model="carta.numero_carta"
								@input="formattaNumeroCarta(carta)"
								placeholder="Solo cifre, max 16"
								:aria-invalid="!!carta.errori.numero">
							<p class="field-hint field-hint-error" x-show="carta.errori.numero" x-text="carta.errori.numero" x-cloak></p>
						</div>

						<div class="field-group">
							<label :for="'scadenza-' + carta._chiave">Scadenza</label>
							<input
								type="text"
								inputmode="numeric"
								:id="'scadenza-' + carta._chiave"
								x-model="carta.scadenza"
								@input="formattaScadenza(carta)"
								placeholder="MM/AA"
								:aria-invalid="!!carta.errori.scadenza">
							<p class="field-hint field-hint-error" x-show="carta.errori.scadenza" x-text="carta.errori.scadenza" x-cloak></p>
						</div>

						<div class="field-group">
							<label :for="'cvv-' + carta._chiave">CVV</label>
							<div class="input-with-action">
								<input
									:type="carta.cvvVisibile ? 'text' : 'password'"
									inputmode="numeric"
									:id="'cvv-' + carta._chiave"
									x-model="carta.cvv"
									@input="formattaCvv(carta)"
									:placeholder="circuito(carta.numero_carta) === 'amex' ? '4 cifre' : '3 cifre'"
									:aria-invalid="!!carta.errori.cvv">
								<button
									type="button"
									class="icon-btn icon-btn-sm"
									@click="toggleCvv(carta._chiave)"
									:aria-label="carta.cvvVisibile ? 'Nascondi CVV' : 'Mostra CVV'">
									<span x-text="carta.cvvVisibile ? '🙈' : '👁️'" aria-hidden="true"></span>
								</button>
							</div>
							<p class="field-hint field-hint-error" x-show="carta.errori.cvv" x-text="carta.errori.cvv" x-cloak></p>
						</div>
					</div>
				</div>
			</template>
		</section>

		<!-- ===================== BARRA AZIONI ===================== -->
		<div class="profile-actions">
			<button
				type="button"
				class="btn btn-danger-outline"
				@click="mostraConfermaEliminazione = true">
				Elimina profilo
			</button>

			<p class="profile-actions-hint" x-show="modificato && !formValido" x-cloak>
				Correggi i campi evidenziati prima di applicare le modifiche.
			</p>
			<button
				type="button"
				class="btn btn-primary"
				:disabled="!modificato || !formValido || invioInCorso"
				@click="inviaModifiche()">
				<span x-show="!invioInCorso">Applica modifiche</span>
				<span x-show="invioInCorso" x-cloak>Applico le modifiche…</span>
			</button>
		</div>

		<!-- ===================== MODAL CONFERMA ELIMINAZIONE ===================== -->
		<div
			class="modal-backdrop"
			x-show="mostraConfermaEliminazione"
			x-cloak
			x-transition.opacity
			@keydown.escape.window="mostraConfermaEliminazione = false">

			<div
				class="modal-box"
				@click.outside="mostraConfermaEliminazione = false"
				role="dialog"
				aria-labelledby="titolo-modal-eliminazione"
				aria-modal="true">

				<h3 id="titolo-modal-eliminazione" class="modal-title">Elimina profilo</h3>
				<p class="modal-description">
					Sei sicuro di voler eliminare il tuo profilo? Questa azione è irreversibile e cancellerà permanentemente tutti i tuoi dati.
				</p>

				<div class="modal-actions">
					<button
						type="button"
						class="btn btn-outline"
						@click="mostraConfermaEliminazione = false"
						:disabled="eliminazioneInCorso">
						Annulla
					</button>
					<button
						type="button"
						class="btn btn-danger"
						@click="eliminaProfilo()"
						:disabled="eliminazioneInCorso">
						<span x-show="!eliminazioneInCorso">Sì, elimina</span>
						<span x-show="eliminazioneInCorso" x-cloak>Eliminazione…</span>
					</button>
				</div>
			</div>
		</div>
	</main>
	<%- include("components/footer")%>
	<script src="/js/profile.js"></script>

</body>
</html>
