<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= ristorante.nome %> - Menù</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/css/global.css">

  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <style>
    :root {
      --color-primary: #D8402A;
      --color-primary-dark: #A82F1E;
      --color-secondary: #1F3D2B;
      --color-accent: #F2A93B;
      --color-success: #3A7D44;
      --color-warning: #C97A0E;
      --color-error: #B3261E;
      --color-info: #2B6CB0;

      --color-neutral-900: #211C1A;
      --color-neutral-700: #4B4340;
      --color-neutral-400: #8C8380;
      --color-neutral-200: #E8E2DD;
      --color-neutral-100: #F5F1EC;
      --color-neutral-0: #FFFFFF;
    }

    * {
      box-sizing: border-box;
    }

    [x-cloak] { display: none !important; }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
      background-color: var(--color-neutral-100);
      color: var(--color-neutral-900);
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1.5rem 5rem;
    }

    /* ===== HERO RISTORANTE ===== */
    .restaurant-header {
      background: var(--color-neutral-0);
      border: 1px solid var(--color-neutral-200);
      border-radius: 16px;
      padding: 2rem;
      margin-bottom: 2.5rem;
      box-shadow: 0 4px 16px rgba(33, 28, 26, 0.04);
    }

    .restaurant-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 2.2rem;
      margin: 0 0 0.8rem 0;
      color: var(--color-neutral-900);
    }

    .restaurant-details {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      color: var(--color-neutral-700);
      font-size: 0.95rem;
    }

    .restaurant-detail-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* ===== SEZIONE MENU ===== */
    .section-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
      color: var(--color-neutral-900);
    }

    .menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.25rem;
    }

    /* ===== CARD PIATTO ===== */
    .card {
      background: var(--color-neutral-0);
      border: 1px solid var(--color-neutral-200);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 2px 10px rgba(33, 28, 26, 0.05);
      display: flex;
      flex-direction: column;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    
    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 16px rgba(33, 28, 26, 0.08);
    }

    .card-img {
      width: 100%;
      height: 170px;
      object-fit: cover;
    }

    .card-body {
      padding: 1.2rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .card-badges {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
      margin-bottom: 0.4rem;
    }

    .badge-categoria {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      background: var(--color-neutral-200);
      color: var(--color-neutral-700);
      padding: 0.15rem 0.5rem;
      border-radius: 20px;
    }

    .badge-tag {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      background: var(--color-neutral-100);
      border: 1px solid var(--color-neutral-200);
      color: var(--color-neutral-400);
      padding: 0.15rem 0.4rem;
      border-radius: 20px;
    }

    .card-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.15rem;
      color: var(--color-neutral-900);
      margin: 0.2rem 0 0.5rem 0;
    }

    .card-prezzo {
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 600;
      font-size: 1.1rem;
      color: var(--color-primary);
      margin-top: auto;
      padding-top: 0.6rem;
    }

    .card-actions {
      margin-top: 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem;
    }

    .qty-selector {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--color-neutral-100);
      border: 1px solid var(--color-neutral-200);
      border-radius: 8px;
      padding: 0.2rem 0.5rem;
    }

    .qty-btn {
      background: none;
      border: none;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--color-neutral-700);
      cursor: pointer;
      width: 24px;
    }

    .qty-value {
      font-family: 'IBM Plex Mono', monospace;
      min-width: 20px;
      text-align: center;
      color: var(--color-neutral-900);
    }

    .btn-ordina {
      flex: 1;
      background: var(--color-primary);
      color: var(--color-neutral-0);
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      border: none;
      border-radius: 8px;
      padding: 0.55rem 1rem;
      cursor: pointer;
      transition: background 0.2s ease;
    }
    .btn-ordina:hover { background: var(--color-primary-dark); }
    .btn-ordina--added { background: var(--color-success); color: var(--color-neutral-0); }

    /* ===== CARRELLO FLOTTANTE ===== */
    .cart-fab {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: var(--color-secondary);
      color: var(--color-neutral-0);
      border: none;
      font-size: 1.4rem;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(0,0,0,0.25);
      z-index: 999;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.15s ease;
    }
    .cart-fab:hover { transform: scale(1.05); }

    .cart-fab-badge {
      position: absolute;
      top: -4px;
      right: -4px;
      background: var(--color-primary);
      color: var(--color-neutral-0);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      font-weight: 600;
      min-width: 20px;
      height: 20px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4px;
      border: 2px solid var(--color-neutral-100);
    }

    .cart-panel {
      position: fixed;
      bottom: 5.3rem;
      right: 1.5rem;
      width: 320px;
      max-width: calc(100vw - 3rem);
      max-height: 70vh;
      background: var(--color-neutral-0);
      border: 1px solid var(--color-neutral-200);
      border-radius: 14px;
      box-shadow: 0 10px 28px rgba(33,28,26,0.18);
      z-index: 998;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .cart-panel-header {
      padding: 1rem 1.2rem 0.6rem;
      border-bottom: 1px solid var(--color-neutral-200);
    }

    .cart-panel-header h4 {
      font-family: 'Space Grotesk', sans-serif;
      margin: 0;
      color: var(--color-neutral-900);
      font-size: 1rem;
    }

    .cart-panel-ristorante {
      font-family: 'Inter', sans-serif;
      font-size: 0.82rem;
      color: var(--color-neutral-400);
      margin: 0.2rem 0 0;
    }

    .cart-panel-list {
      list-style: none;
      margin: 0;
      padding: 0.4rem 0.8rem;
      overflow-y: auto;
      flex: 1;
    }

    .cart-panel-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.5rem 0.2rem;
      border-bottom: 1px dashed var(--color-neutral-200);
    }
    .cart-panel-item:last-child { border-bottom: none; }

    .cart-panel-item img {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      object-fit: cover;
      flex-shrink: 0;
    }

    .cart-panel-item-name {
      flex: 1;
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      color: var(--color-neutral-900);
    }

    .cart-panel-item-price {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.78rem;
      color: var(--color-neutral-700);
    }

    .cart-panel-item-qty {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.78rem;
      color: var(--color-neutral-700);
    }

    .cart-panel-remove {
      background: none;
      border: none;
      color: var(--color-neutral-400);
      cursor: pointer;
      font-size: 0.85rem;
      padding: 0.2rem;
      line-height: 1;
    }
    .cart-panel-remove:hover { color: var(--color-error); }

    .cart-panel-empty {
      padding: 1.2rem;
      text-align: center;
      color: var(--color-neutral-400);
      font-size: 0.85rem;
    }

    .btn-procedi {
      margin: 0.8rem;
      background: var(--color-primary);
      color: var(--color-neutral-0);
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      border: none;
      border-radius: 8px;
      padding: 0.7rem;
      cursor: pointer;
      transition: background 0.2s ease;
    }
    .btn-procedi:hover { background: var(--color-primary-dark); }
    .btn-procedi:disabled {
      background: var(--color-neutral-400);
      cursor: not-allowed;
    }

    /* ===== OVERLAY MODALE & TOAST ===== */
    .modal-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(33, 28, 26, 0.6);
      backdrop-filter: blur(2px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .modal-card {
      background: var(--color-neutral-0);
      border-radius: 14px;
      max-width: 420px;
      width: 100%;
      padding: 1.5rem;
      box-shadow: 0 12px 32px rgba(33, 28, 26, 0.2);
    }

    .modal-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.2rem;
      margin: 0 0 0.8rem 0;
      color: var(--color-neutral-900);
    }

    .modal-body {
      font-size: 0.95rem;
      color: var(--color-neutral-700);
      line-height: 1.4;
      margin-bottom: 1.5rem;
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.8rem;
    }

    .btn-cancel {
      background: transparent;
      border: 1px solid var(--color-neutral-200);
      color: var(--color-neutral-700);
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      padding: 0.55rem 1rem;
      border-radius: 8px;
      cursor: pointer;
    }
    .btn-cancel:hover { background: var(--color-neutral-100); }

    .btn-confirm {
      background: var(--color-primary);
      border: none;
      color: var(--color-neutral-0);
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      padding: 0.55rem 1rem;
      border-radius: 8px;
      cursor: pointer;
    }
    .btn-confirm:hover { background: var(--color-primary-dark); }

    .toast-notification {
      position: fixed;
      top: 1.5rem;
      right: 1.5rem;
      background: var(--color-error);
      color: var(--color-neutral-0);
      padding: 0.9rem 1.2rem;
      border-radius: 8px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.15);
      z-index: 1001;
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      max-width: 360px;
    }

    .toast-close {
      background: none;
      border: none;
      color: var(--color-neutral-0);
      font-size: 1rem;
      cursor: pointer;
      padding: 0;
      margin-left: auto;
    }
  </style>
</head>
<body>

  <%- include('components/header') %>

  <main class="container">

    <!-- ===== HEADER DEL RISTORANTE ===== -->
    <header class="restaurant-header">
      <h1 class="restaurant-title"><%= ristorante.nome %></h1>
      <div class="restaurant-details">
        <div class="restaurant-detail-item">
          📍 <span><%= ristorante.via %></span>
        </div>
        <div class="restaurant-detail-item">
          📞 <span><%= ristorante.n_tell %></span>
        </div>
      </div>
    </header>

    <!-- ===== MENU DEL RISTORANTE ===== -->
    <section>
      <h2 class="section-title">Menù</h2>

      <% if (!ristorante.menu || ristorante.menu.length === 0) { %>
        <p style="color: var(--color-neutral-400);">Nessun piatto disponibile in questo menù.</p>
      <% } else { %>
        <div class="menu-grid">

          <% ristorante.menu.forEach(function(piatto, index) { %>
            <div
              class="card"
              x-data="{
                qty: 1,
                added: false,
                item: <%- JSON.stringify({
                  id: ristorante.id,
                  nome: ristorante.nome,
                  idMeal: piatto.idMeal || (ristorante.id + '-' + index),
                  strMeal: piatto.strMeal,
                  strMealThumb: piatto.strMealThumb,
                  price: piatto.price
                }).replace(/"/g, '&quot;') %>
              }"
            >
              <img
                src="<%= piatto.strMealThumb %>"
                alt="<%= piatto.strMeal %>"
                class="card-img"
              />

              <div class="card-body">
                <div class="card-badges">
                  <% if (piatto.strCategory) { %>
                    <span class="badge-categoria"><%= piatto.strCategory %></span>
                  <% } %>
                  <% if (piatto.strTags) { %>
                    <span class="badge-tag"><%= piatto.strTags %></span>
                  <% } %>
                </div>

                <h3 class="card-title"><%= piatto.strMeal %></h3>

                <% if (piatto.price !== undefined && piatto.price !== null) { %>
                  <p class="card-prezzo">€<%= Number(piatto.price).toFixed(2) %></p>
                <% } %>

                <div class="card-actions">
                  <div class="qty-selector">
                    <button
                      type="button"
                      @click="qty > 1 && qty--"
                      class="qty-btn"
                    >−</button>
                    <span class="qty-value" x-text="qty"></span>
                    <button
                      type="button"
                      @click="qty++"
                      class="qty-btn"
                    >+</button>
                  </div>

                  <button
                    type="button"
                    class="btn-ordina"
                    :class="{ 'btn-ordina--added': added }"
                    @click="
                      $store.cart.addItem(item, qty, () => {
                        added = true;
                        setTimeout(() => added = false, 1200);
                      });
                    "
                  >
                    <span x-show="!added">Ordina</span>
                    <span x-show="added" x-cloak>Aggiunto ✓</span>
                  </button>
                </div>
              </div>
            </div>
          <% }) %>

        </div>
      <% } %>
    </section>

  </main>

  <!-- ===== CARRELLO FLOTTANTE ===== -->
  <div x-data="cartWidget()" x-show="$store.cart.totalItems > 0" style="display: none;">

    <button type="button" class="cart-fab" @click="open = !open" aria-label="Carrello">
      🛒
      <span class="cart-fab-badge" x-text="$store.cart.totalItems"></span>
    </button>

    <div
      x-show="open"
      x-transition
      @click.outside="open = false"
      class="cart-panel"
      x-cloak
    >
      <div class="cart-panel-header">
        <h4>Il tuo ordine</h4>
        <p class="cart-panel-ristorante" x-text="$store.cart.restaurantName"></p>
      </div>

      <template x-if="$store.cart.items.length === 0">
        <p class="cart-panel-empty">Il carrello è vuoto.</p>
      </template>

      <ul class="cart-panel-list" x-show="$store.cart.items.length > 0">
        <template x-for="item in $store.cart.items" :key="item.idMeal">
          <li class="cart-panel-item">
            <img :src="item.strMealThumb" :alt="item.strMeal" />
            <span class="cart-panel-item-name" x-text="item.strMeal"></span>
            <template x-if="item.price !== undefined && item.price !== null">
              <span class="cart-panel-item-price" x-text="'€' + Number(item.price).toFixed(2)"></span>
            </template>
            <span class="cart-panel-item-qty" x-text="'x' + item.qty"></span>
            <button
              type="button"
              class="cart-panel-remove"
              @click="$store.cart.removeItem(item.idMeal)"
              aria-label="Rimuovi"
            >✕</button>
          </li>
        </template>
      </ul>

      <button
        type="button"
        class="btn-procedi"
        :disabled="$store.cart.items.length === 0 || submitting"
        @click="procedi()"
      >
        <span x-show="!submitting">Procedi all'ordine</span>
        <span x-show="submitting" x-cloak>Invio in corso...</span>
      </button>
    </div>
  </div>

  <!-- ===== DIALOG MODALE PER CONFERMA CAMBIO RISTORANTE ===== -->
  <div
    x-data
    x-show="$store.cart.pendingModal.show"
    class="modal-backdrop"
    x-transition
    x-cloak
  >
    <div class="modal-card" @click.outside="$store.cart.cancelChange()">
      <h3 class="modal-title">Svuotare il carrello?</h3>
      <p class="modal-body">
        Il carrello contiene già piatti di <strong x-text="'&quot;' + $store.cart.restaurantName + '&quot;'"></strong>.
        Vuoi svuotarlo per aggiungere piatti da <strong x-text="'&quot;' + $store.cart.pendingModal.newItem?.nome + '&quot;'"></strong>?
      </p>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" @click="$store.cart.cancelChange()">Annulla</button>
        <button type="button" class="btn-confirm" @click="$store.cart.confirmChange()">Svuota e aggiungi</button>
      </div>
    </div>
  </div>

  <!-- ===== TOAST PER NOTIFICA ERRORI ===== -->
  <div
    x-data
    x-show="$store.cart.toast.show"
    class="toast-notification"
    x-transition
    x-cloak
  >
    <span x-text="$store.cart.toast.message"></span>
    <button type="button" class="toast-close" @click="$store.cart.toast.show = false">✕</button>
  </div>

  <%- include('components/footer') %>

  <script>
    document.addEventListener('alpine:init', () => {
      Alpine.store('cart', {
        items: JSON.parse(localStorage.getItem('cart') || '[]'),
        restaurantId: localStorage.getItem('cartRestaurantId') || null,
        restaurantName: localStorage.getItem('cartRestaurantName') || null,

        pendingModal: {
          show: false,
          newItem: null,
          newQty: 1,
          onSuccess: null
        },

        toast: {
          show: false,
          message: ''
        },

        showError(msg) {
          this.toast.message = msg;
          this.toast.show = true;
          setTimeout(() => {
            this.toast.show = false;
          }, 4000);
        },

        addItem(item, qty, onSuccess) {
          if (this.items.length > 0 && this.restaurantId && String(this.restaurantId) !== String(item.id)) {
            this.pendingModal.newItem = item;
            this.pendingModal.newQty = qty;
            this.pendingModal.onSuccess = onSuccess;
            this.pendingModal.show = true;
            return;
          }

          this._executeAddItem(item, qty);
          if (onSuccess) onSuccess();
        },

        confirmChange() {
          this.clear();
          this._executeAddItem(this.pendingModal.newItem, this.pendingModal.newQty);
          if (this.pendingModal.onSuccess) this.pendingModal.onSuccess();
          this.cancelChange();
        },

        cancelChange() {
          this.pendingModal.show = false;
          this.pendingModal.newItem = null;
          this.pendingModal.newQty = 1;
          this.pendingModal.onSuccess = null;
        },

        _executeAddItem(item, qty) {
          this.restaurantId = item.id;
          this.restaurantName = item.nome;

          const existing = this.items.find((i) => i.idMeal === item.idMeal);
          if (existing) {
            existing.qty += qty;
          } else {
            this.items.push({
              idMeal: item.idMeal,
              strMeal: item.strMeal,
              strMealThumb: item.strMealThumb,
              price: item.price,
              qty
            });
          }

          this._persist();
        },

        removeItem(idMeal) {
          this.items = this.items.filter((i) => i.idMeal !== idMeal);
          if (this.items.length === 0) {
            this.restaurantId = null;
            this.restaurantName = null;
          }
          this._persist();
        },

        clear() {
          this.items = [];
          this.restaurantId = null;
          this.restaurantName = null;
          this._persist();
        },

        _persist() {
          localStorage.setItem('cart', JSON.stringify(this.items));
          if (this.restaurantId) {
            localStorage.setItem('cartRestaurantId', this.restaurantId);
            localStorage.setItem('cartRestaurantName', this.restaurantName || '');
          } else {
            localStorage.removeItem('cartRestaurantId');
            localStorage.removeItem('cartRestaurantName');
          }
        },

        get totalItems() {
          return this.items.reduce((sum, i) => sum + i.qty, 0);
        }
      });
    });

    function cartWidget() {
      return {
        open: false,
        submitting: false,

        async procedi() {
          const cart = Alpine.store('cart');
          if (!cart.items.length || this.submitting) return;

          this.submitting = true;
          try {
            const res = await fetch('/ordine', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'include',
              body: JSON.stringify({
                ristoranteId: cart.restaurantId,
                items: cart.items.map((i) => ({
                  idMeal: i.idMeal,
                  nome: i.strMeal,
                  price: i.price,
                  qty: i.qty
                }))
              })
            });

            if (!res.ok) throw new Error('Richiesta non riuscita');

            const data = await res.json();

            if (data.redirectUrl) {
              cart.clear();
              window.location.href = data.redirectUrl;
            } else {
              throw new Error('Risposta inattesa dal server');
            }
          } catch (err) {
            console.error(err);
            cart.showError("Non è stato possibile procedere con l'ordine. Riprova.");
          } finally {
            this.submitting = false;
          }
        }
      };
    }
  </script>
</body>
</html>