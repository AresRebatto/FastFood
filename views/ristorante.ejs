<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= ristorante.nome %> - Menù</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/css/global.css">

  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <style>
    :root {
      --color-primary: #D8402A;
      --color-primary-dark: #A82F1E;
      --color-secondary: #1F3D2B;
      --color-accent: #F2A93B;
      --color-success: #3A7D44;
      --color-warning: #C97A0E;
      --color-error: #B3261E;
      --color-info: #2B6CB0;

      --color-neutral-900: #211C1A;
      --color-neutral-700: #4B4340;
      --color-neutral-400: #8C8380;
      --color-neutral-200: #E8E2DD;
      --color-neutral-100: #F5F1EC;
      --color-neutral-0: #FFFFFF;
    }

    * { box-sizing: border-box; }

    [x-cloak] { display: none !important; }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
      background-color: var(--color-neutral-100);
      color: var(--color-neutral-900);
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1.5rem 5rem;
    }

    /* ===== HERO RISTORANTE ===== */
    .restaurant-header {
      background: var(--color-neutral-0);
      border: 1px solid var(--color-neutral-200);
      border-radius: 16px;
      padding: 2rem;
      margin-bottom: 2.5rem;
      box-shadow: 0 4px 16px rgba(33, 28, 26, 0.04);
    }

    .restaurant-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 2.2rem;
      margin: 0 0 0.8rem 0;
      color: var(--color-neutral-900);
    }

    .restaurant-details {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      color: var(--color-neutral-700);
      font-size: 0.95rem;
    }

    .restaurant-detail-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* ===== SEZIONE MENU ===== */
    .section-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
      color: var(--color-neutral-900);
    }

    .menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.25rem;
    }

    /* ===== CARD PIATTO ===== */
    .card {
      background: var(--color-neutral-0);
      border: 1px solid var(--color-neutral-200);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 2px 10px rgba(33, 28, 26, 0.05);
      display: flex;
      flex-direction: column;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 16px rgba(33, 28, 26, 0.08);
    }

    .card-img {
      width: 100%;
      height: 170px;
      object-fit: cover;
    }

    .card-body {
      padding: 1.2rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .card-badges {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
      margin-bottom: 0.4rem;
    }

    .badge-categoria {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.75rem;
      background: var(--color-neutral-200);
      color: var(--color-neutral-700);
      padding: 0.15rem 0.5rem;
      border-radius: 20px;
    }

    .badge-tag {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      background: var(--color-neutral-100);
      border: 1px solid var(--color-neutral-200);
      color: var(--color-neutral-400);
      padding: 0.15rem 0.4rem;
      border-radius: 20px;
    }

    .card-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.15rem;
      color: var(--color-neutral-900);
      margin: 0.2rem 0 0.5rem 0;
    }

    .card-prezzo {
      font-family: 'IBM Plex Mono', monospace;
      font-weight: 600;
      font-size: 1.1rem;
      color: var(--color-primary);
      margin-top: auto;
      padding-top: 0.6rem;
    }

    .card-actions {
      margin-top: 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem;
    }

    .qty-selector {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--color-neutral-100);
      border: 1px solid var(--color-neutral-200);
      border-radius: 8px;
      padding: 0.2rem 0.5rem;
    }

    .qty-btn {
      background: none;
      border: none;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--color-neutral-700);
      cursor: pointer;
      width: 24px;
    }

    .qty-value {
      font-family: 'IBM Plex Mono', monospace;
      min-width: 20px;
      text-align: center;
      color: var(--color-neutral-900);
    }

    .btn-ordina {
      flex: 1;
      background: var(--color-primary);
      color: var(--color-neutral-0);
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 600;
      border: none;
      border-radius: 8px;
      padding: 0.55rem 1rem;
      cursor: pointer;
      transition: background 0.2s ease;
    }
    .btn-ordina:hover { background: var(--color-primary-dark); }
    .btn-ordina--added { background: var(--color-success); color: var(--color-neutral-0); }
  </style>
</head>
<body>

  <%- include('components/header') %>

  <main class="container">

    <!-- ===== HEADER DEL RISTORANTE ===== -->
    <header class="restaurant-header">
      <h1 class="restaurant-title"><%= ristorante.nome %></h1>
      <div class="restaurant-details">
        <div class="restaurant-detail-item">
          📍 <span><%= ristorante.via %></span>
        </div>
        <div class="restaurant-detail-item">
          📞 <span><%= ristorante.n_tell %></span>
        </div>
      </div>
    </header>

    <!-- ===== MENU DEL RISTORANTE ===== -->
    <section>
      <h2 class="section-title">Menù</h2>

      <% if (!ristorante.menu || ristorante.menu.length === 0) { %>
        <p style="color: var(--color-neutral-400);">Nessun piatto disponibile in questo menù.</p>
      <% } else { %>
        <div class="menu-grid">

          <% ristorante.menu.forEach(function(piatto, index) { %>
            <div
              class="card"
              x-data="{
                qty: 1,
                added: false,
                item: <%- JSON.stringify({
                  id: ristorante.id,
                  nome: ristorante.nome,
                  idMeal: piatto.idMeal || (ristorante.id + '-' + index),
                  strMeal: piatto.strMeal,
                  strMealThumb: piatto.strMealThumb,
                  price: piatto.price
                }).replace(/"/g, '&quot;') %>
              }"
            >
              <img
                src="<%= piatto.strMealThumb %>"
                alt="<%= piatto.strMeal %>"
                class="card-img"
              />

              <div class="card-body">
                <div class="card-badges">
                  <% if (piatto.strCategory) { %>
                    <span class="badge-categoria"><%= piatto.strCategory %></span>
                  <% } %>
                  <% if (piatto.strTags) { %>
                    <span class="badge-tag"><%= piatto.strTags %></span>
                  <% } %>
                </div>

                <h3 class="card-title"><%= piatto.strMeal %></h3>

                <% if (piatto.price !== undefined && piatto.price !== null) { %>
                  <p class="card-prezzo">€<%= Number(piatto.price).toFixed(2) %></p>
                <% } %>

                <div class="card-actions">
                  <div class="qty-selector">
                    <button
                      type="button"
                      @click="qty > 1 && qty--"
                      class="qty-btn"
                    >−</button>
                    <span class="qty-value" x-text="qty"></span>
                    <button
                      type="button"
                      @click="qty++"
                      class="qty-btn"
                    >+</button>
                  </div>

                  <button
                    type="button"
                    class="btn-ordina"
                    :class="{ 'btn-ordina--added': added }"
                    @click="
                      $store.cart.addItem(item, qty, () => {
                        added = true;
                        setTimeout(() => added = false, 1200);
                      });
                    "
                  >
                    <span x-show="!added">Ordina</span>
                    <span x-show="added" x-cloak>Aggiunto ✓</span>
                  </button>
                </div>
              </div>
            </div>
          <% }) %>

        </div>
      <% } %>
    </section>

  </main>

  <%- include('components/cart') %>

  <%- include('components/footer') %>

</body>
</html>
