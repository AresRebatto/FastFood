<link rel="stylesheet" href="/css/header.css">

<header class="site-header" id="site-header" x-data="{ userMenuOpen: false, mobileNavOpen: false }" @click.outside="userMenuOpen = false">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-mark" aria-hidden="true">🍔</span>
      <span class="logo-text">FastFood</span>
    </a>

    <div class="header-actions">
      <% if (role) { %>
        <!-- ===== UTENTE LOGGATO: menu profilo ===== -->
        <div class="user-menu">
          <button
            type="button"
            class="btn btn-outline btn-sm user-menu-trigger"
            @click="userMenuOpen = !userMenuOpen"
            :aria-expanded="userMenuOpen"
            aria-haspopup="true">
            <span class="user-menu-avatar" aria-hidden="true"><%= role === 'R' ? '🧑‍🍳' : '🍽️' %></span>
            <span><%= role === 'R' ? 'Il mio ristorante' : 'Profilo' %></span>
          </button>

          <div class="user-menu-panel" x-show="userMenuOpen" x-cloak x-transition role="menu">
            <% if (role === 'R') { %>
              <a href="/profilo" role="menuitem">Il mio profilo</a>
              <a href="/ristorante" role="menuitem">Gestisci ristorante</a>
              <a href="/ordini-ricevuti" role="menuitem">Ordini ricevuti</a>
            <% } else { %>
              <a href="/profilo" role="menuitem">Il mio profilo</a>
              <a href="/ordini" role="menuitem">I miei ordini</a>
            <% } %>
            <hr>
            <button type="button" class="logout-item"  onclick="document.getElementById('logout-form').submit()" role="menuitem">Esci</button>
          </div>
        </div>
      <% } else { %>
        <!-- ===== UTENTE ANONIMO: accedi/registrati ===== -->
        <a href="/login" class="btn btn-outline btn-sm">Accedi</a>
        <a href="/signup" class="btn btn-primary btn-sm">Registrati</a>
      <% } %>

      <button
        class="icon-btn hamburger"
        id="hamburger-btn"
        aria-label="Apri il menu"
        :aria-expanded="mobileNavOpen"
        aria-controls="mobile-nav"
        @click="mobileNavOpen = !mobileNavOpen">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <nav class="mobile-nav" id="mobile-nav" aria-label="Navigazione mobile" x-show="mobileNavOpen" x-cloak>
    <% if (role) { %>
      <div class="mobile-nav-user">
        <span class="user-menu-avatar" aria-hidden="true"><%= role === 'R' ? '🧑‍🍳' : '🍽️' %></span>
        <span class="mobile-nav-user-name"><%= role === 'R' ? 'Ristoratore' : 'Cliente' %></span>
      </div>
      <% if (role === 'R') { %>
        <a href="/profilo">Il mio profilo</a>
        <a href="/ristorante">Gestisci ristorante</a>
        <a href="/ordini-ricevuti">Ordini ricevuti</a>
      <% } else { %>
        <a href="/profilo">Il mio profilo</a>
        <a href="/ordini">I miei ordini</a>
      <% } %>
      <button type="button" class="logout-item" onclick="document.getElementById('logout-form').submit()">Esci</button>
    <% } else { %>
      <a href="/login" class="btn btn-outline btn-block">Accedi</a>
      <a href="/signup" class="btn btn-primary btn-block">Registrati</a>
    <% } %>
  </nav>
</header>

<form id="logout-form" action="/logout" method="POST" style="display:none;"></form>
