<!-- ===== STILI DEL CARRELLO, MODALE E TOAST ===== -->
<style>
  :root {
    --color-primary: #D8402A;
    --color-primary-dark: #A82F1E;
    --color-secondary: #1F3D2B;
    --color-accent: #F2A93B;
    --color-success: #3A7D44;
    --color-warning: #C97A0E;
    --color-error: #B3261E;
    --color-info: #2B6CB0;

    --color-neutral-900: #211C1A;
    --color-neutral-700: #4B4340;
    --color-neutral-400: #8C8380;
    --color-neutral-200: #E8E2DD;
    --color-neutral-100: #F5F1EC;
    --color-neutral-0: #FFFFFF;
  }

  /* Floating Action Button (FAB) */
  .cart-fab {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--color-secondary);
    color: var(--color-neutral-0);
    border: none;
    font-size: 1.4rem;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease;
  }
  .cart-fab:hover {
    transform: scale(1.05);
  }

  .cart-fab-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    background: var(--color-primary);
    color: var(--color-neutral-0);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    min-width: 20px;
    height: 20px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    border: 2px solid var(--color-neutral-100);
  }

  /* Pannello Carrello */
  .cart-panel {
    position: fixed;
    bottom: 5.3rem;
    right: 1.5rem;
    width: 320px;
    max-width: calc(100vw - 3rem);
    max-height: 70vh;
    background: var(--color-neutral-0);
    border: 1px solid var(--color-neutral-200);
    border-radius: 14px;
    box-shadow: 0 10px 28px rgba(33, 28, 26, 0.18);
    z-index: 998;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .cart-panel-header {
    padding: 1rem 1.2rem 0.6rem;
    border-bottom: 1px solid var(--color-neutral-200);
  }

  .cart-panel-header h4 {
    font-family: 'Space Grotesk', sans-serif;
    margin: 0;
    color: var(--color-neutral-900);
    font-size: 1rem;
  }

  .cart-panel-ristorante {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    color: var(--color-neutral-400);
    margin: 0.2rem 0 0;
  }

  .cart-panel-list {
    list-style: none;
    margin: 0;
    padding: 0.4rem 0.8rem;
    overflow-y: auto;
    flex: 1;
  }

  .cart-panel-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.2rem;
    border-bottom: 1px dashed var(--color-neutral-200);
  }
  .cart-panel-item:last-child {
    border-bottom: none;
  }

  .cart-panel-item img {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .cart-panel-item-name {
    flex: 1;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: var(--color-neutral-900);
  }

  .cart-panel-item-price,
  .cart-panel-item-qty {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.78rem;
    color: var(--color-neutral-700);
  }

  .cart-panel-remove {
    background: none;
    border: none;
    color: var(--color-neutral-400);
    cursor: pointer;
    font-size: 0.85rem;
    padding: 0.2rem;
    line-height: 1;
  }
  .cart-panel-remove:hover {
    color: var(--color-error);
  }

  .cart-panel-empty {
    padding: 1.2rem;
    text-align: center;
    color: var(--color-neutral-400);
    font-size: 0.85rem;
  }

  .btn-procedi {
    margin: 0.8rem;
    background: var(--color-primary);
    color: var(--color-neutral-0);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    padding: 0.7rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .btn-procedi:hover {
    background: var(--color-primary-dark);
  }
  .btn-procedi:disabled {
    background: var(--color-neutral-400);
    cursor: not-allowed;
  }

  /* Overlay Modale */
  .modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(33, 28, 26, 0.6);
    backdrop-filter: blur(2px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .modal-card {
    background: var(--color-neutral-0);
    border-radius: 14px;
    max-width: 420px;
    width: 100%;
    padding: 1.5rem;
    box-shadow: 0 12px 32px rgba(33, 28, 26, 0.2);
  }

  .modal-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.2rem;
    margin: 0 0 0.8rem 0;
    color: var(--color-neutral-900);
  }

  .modal-body {
    font-size: 0.95rem;
    color: var(--color-neutral-700);
    line-height: 1.4;
    margin-bottom: 1.5rem;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.8rem;
  }

  .btn-cancel {
    background: transparent;
    border: 1px solid var(--color-neutral-200);
    color: var(--color-neutral-700);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    padding: 0.55rem 1rem;
    border-radius: 8px;
    cursor: pointer;
  }
  .btn-cancel:hover {
    background: var(--color-neutral-100);
  }

  .btn-confirm {
    background: var(--color-primary);
    border: none;
    color: var(--color-neutral-0);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    padding: 0.55rem 1rem;
    border-radius: 8px;
    cursor: pointer;
  }
  .btn-confirm:hover {
    background: var(--color-primary-dark);
  }

  /* Toast Notification */
  .toast-notification {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    background: var(--color-error);
    color: var(--color-neutral-0);
    padding: 0.9rem 1.2rem;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.15);
    z-index: 1001;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    max-width: 360px;
  }

  .toast-close {
    background: none;
    border: none;
    color: var(--color-neutral-0);
    font-size: 1rem;
    cursor: pointer;
    padding: 0;
    margin-left: auto;
  }
</style>

<!-- ===== CARRELLO FLOTTANTE ===== -->
<div x-data="cartWidget()" x-show="$store.cart.totalItems > 0" style="display: none;">

  <button type="button" class="cart-fab" @click="open = !open" aria-label="Carrello">
    🛒
    <span class="cart-fab-badge" x-text="$store.cart.totalItems"></span>
  </button>

  <div
    x-show="open"
    x-transition
    @click.outside="open = false"
    class="cart-panel"
    x-cloak
  >
    <div class="cart-panel-header">
      <h4>Il tuo ordine</h4>
      <p class="cart-panel-ristorante" x-text="$store.cart.restaurantName"></p>
    </div>

    <template x-if="$store.cart.items.length === 0">
      <p class="cart-panel-empty">Il carrello è vuoto.</p>
    </template>

    <ul class="cart-panel-list" x-show="$store.cart.items.length > 0">
      <template x-for="item in $store.cart.items" :key="item.idMeal">
        <li class="cart-panel-item">
          <img :src="item.strMealThumb" :alt="item.strMeal" />
          <span class="cart-panel-item-name" x-text="item.strMeal"></span>
          <template x-if="item.price !== undefined && item.price !== null">
            <span class="cart-panel-item-price" x-text="'€' + Number(item.price).toFixed(2)"></span>
          </template>
          <span class="cart-panel-item-qty" x-text="'x' + item.qty"></span>
          <button
            type="button"
            class="cart-panel-remove"
            @click="$store.cart.removeItem(item.idMeal)"
            aria-label="Rimuovi"
          >✕</button>
        </li>
      </template>
    </ul>

    <button
      type="button"
      class="btn-procedi"
      :disabled="$store.cart.items.length === 0 || submitting"
      @click="procedi()"
    >
      <span x-show="!submitting">Procedi all'ordine</span>
      <span x-show="submitting" x-cloak>Invio in corso...</span>
    </button>
  </div>
</div>

<!-- ===== MODALE DI CONFERMA ===== -->
<div
  x-data
  x-show="$store.cart.pendingModal.show"
  class="modal-backdrop"
  x-transition
  x-cloak
>
  <div class="modal-card" @click.outside="$store.cart.cancelChange()">
    <h3 class="modal-title">Svuotare il carrello?</h3>
    <p class="modal-body">
      Il carrello contiene già piatti di <strong x-text="'&quot;' + $store.cart.restaurantName + '&quot;'"></strong>.
      Vuoi svuotarlo per aggiungere piatti da <strong x-text="'&quot;' + $store.cart.pendingModal.newItem?.nome + '&quot;'"></strong>?
    </p>
    <div class="modal-actions">
      <button type="button" class="btn-cancel" @click="$store.cart.cancelChange()">Annulla</button>
      <button type="button" class="btn-confirm" @click="$store.cart.confirmChange()">Svuota e aggiungi</button>
    </div>
  </div>
</div>

<!-- ===== TOAST DI ERRORE ===== -->
<div
  x-data
  x-show="$store.cart.toast.show"
  class="toast-notification"
  x-transition
  x-cloak
>
  <span x-text="$store.cart.toast.message"></span>
  <button type="button" class="toast-close" @click="$store.cart.toast.show = false">✕</button>
</div>

<!-- ===== SCRIPT ALPINE.JS STORE & CONTROLLER ===== -->
<script>
  document.addEventListener('alpine:init', () => {
    if (!Alpine.store('cart')) {
      Alpine.store('cart', {
        items: JSON.parse(localStorage.getItem('cart') || '[]'),
        restaurantId: localStorage.getItem('cartRestaurantId') || null,
        restaurantName: localStorage.getItem('cartRestaurantName') || null,

        pendingModal: {
          show: false,
          newItem: null,
          newQty: 1,
          onSuccess: null
        },

        toast: {
          show: false,
          message: ''
        },

        showError(msg) {
          this.toast.message = msg;
          this.toast.show = true;
          setTimeout(() => {
            this.toast.show = false;
          }, 4000);
        },

        addItem(item, qty, onSuccess) {
          if (this.items.length > 0 && this.restaurantId && String(this.restaurantId) !== String(item.id)) {
            this.pendingModal.newItem = item;
            this.pendingModal.newQty = qty;
            this.pendingModal.onSuccess = onSuccess;
            this.pendingModal.show = true;
            return;
          }

          this._executeAddItem(item, qty);
          if (onSuccess) onSuccess();
        },

        confirmChange() {
          this.clear();
          this._executeAddItem(this.pendingModal.newItem, this.pendingModal.newQty);
          if (this.pendingModal.onSuccess) this.pendingModal.onSuccess();
          this.cancelChange();
        },

        cancelChange() {
          this.pendingModal.show = false;
          this.pendingModal.newItem = null;
          this.pendingModal.newQty = 1;
          this.pendingModal.onSuccess = null;
        },

        _executeAddItem(item, qty) {
          this.restaurantId = item.id;
          this.restaurantName = item.nome;

          const existing = this.items.find((i) => i.idMeal === item.idMeal);
          if (existing) {
            existing.qty += qty;
          } else {
            this.items.push({
              idMeal: item.idMeal,
              strMeal: item.strMeal,
              strMealThumb: item.strMealThumb,
              price: item.price,
              qty
            });
          }

          this._persist();
        },

        removeItem(idMeal) {
          this.items = this.items.filter((i) => i.idMeal !== idMeal);
          if (this.items.length === 0) {
            this.restaurantId = null;
            this.restaurantName = null;
          }
          this._persist();
        },

        clear() {
          this.items = [];
          this.restaurantId = null;
          this.restaurantName = null;
          this._persist();
        },

        _persist() {
          localStorage.setItem('cart', JSON.stringify(this.items));
          if (this.restaurantId) {
            localStorage.setItem('cartRestaurantId', this.restaurantId);
            localStorage.setItem('cartRestaurantName', this.restaurantName || '');
          } else {
            localStorage.removeItem('cartRestaurantId');
            localStorage.removeItem('cartRestaurantName');
          }
        },

        get totalItems() {
          return this.items.reduce((sum, i) => sum + i.qty, 0);
        }
      });
    }
  });

  function cartWidget() {
    return {
      open: false,
      submitting: false,

      async procedi() {
        const cart = Alpine.store('cart');
        if (!cart.items.length || this.submitting) return;

        this.submitting = true;
        try {
          const res = await fetch('/invio-ordine', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
              ristoranteId: cart.restaurantId,
              ristoranteNome: cart.restaurantName,
              items: cart.items.map((i) => ({
                idMeal: i.idMeal,
                nome: i.strMeal,
                price: i.price,
                qty: i.qty
              }))
            })
          });

          if (!res.ok) throw new Error('Richiesta non riuscita');

          const data = await res.json();

          if (data.redirectUrl) {
            cart.clear();
            window.location.href = data.redirectUrl;
          } else {
            throw new Error('Risposta inattesa dal server');
          }
        } catch (err) {
          console.error(err);
          cart.showError("Non è stato possibile procedere con l'ordine. Riprova.");
        } finally {
          this.submitting = false;
        }
      }
    };
  }
</script>
