<link rel="stylesheet" href="/css/consigliati.css">

<section class="cons-bar" x-data="consigliati()" x-show="items.length > 0" x-cloak>

  <div class="cons-bar__head">
    <div>
      <p class="cons-bar__eyebrow">Per te</p>
      <h2 class="cons-bar__title">I tuoi ultimi piatti</h2>
    </div>
    <div class="cons-bar__nav">
      <button type="button" class="cons-nav-btn" @click="scroll(-1)" aria-label="Scorri a sinistra">‹</button>
      <button type="button" class="cons-nav-btn" @click="scroll(1)" aria-label="Scorri a destra">›</button>
    </div>
  </div>

  <div class="cons-bar__track" x-ref="track">
    <template x-for="item in items" :key="item.idMeal + '-' + item.ristorante_id">
      <article class="cons-card">
        <img class="cons-card__thumb" :src="item.strMealThumb" :alt="item.strMeal" loading="lazy">
        <div class="cons-card__body">
          <p class="cons-card__name" x-text="item.strMeal"></p>
          <p class="cons-card__resto" x-text="item.ristorante_nome"></p>
          <p class="cons-card__price" x-show="item.price !== null" x-text="'€ ' + Number(item.price).toFixed(2)"></p>
        </div>
        <a class="cons-card__btn" :href="'/ristorante/' + item.ristorante_id">Vai al ristorante</a>
      </article>
    </template>
  </div>

</section>

<script id="ejs-consigliati-data" type="application/json"><%- JSON.stringify(consigliati || []) %></script>
<script src="/js/consigliati.js"></script>
